# ЛБ-6: данные варианта и пути. В каждом новом терминале хоста:  cd ~/lab6 && source lab6.env

export N=18 G=63
export VM_NAME=vm-18-63            # HOST = vm-N-G
export VM_USER=stud-18             # USER = stud-N
export VCPU=3                      # 1 + (18 mod 4) = 1 + 2
export RAM_MB=1792                 # 1024 + 256·(18 mod 5) = 1024 + 256·3
export DISK_GB=15                  # 8 + (63 mod 8) = 8 + 7

export NET=lab6                    # сеть libvirt, описание — libvirt/lab6-net.xml
export NET_CIDR=10.97.2.96/27      # свободный блок плана ЛБ-3 (P = 97)
export GW=10.97.2.97               # мост virbr-lab6 на хосте: шлюз, NAT и DNS для ВМ

export IMG=/var/lib/libvirt/images/lab6                        # диски ВМ, seed-ISO, шаблон
export BASE_IMG=$IMG/base/noble-server-cloudimg-amd64.img      # облачный образ Ubuntu 24.04
export TPL_IMG=$IMG/tpl-vm-18-63.qcow2                         # шаблон (часть В)
export OS_VARIANT=ubuntu24.04      # проверить: osinfo-query os | grep -i ubuntu2  (нет — ubuntu22.04)

export SSH_KEY=~/.ssh/lab6_stud18

# без этого virsh от обычного пользователя работает с qemu:///session и «не видит» ВМ и сеть
export LIBVIRT_DEFAULT_URI=qemu:///system
# единый формат чисел и сообщений на хосте и в ВМ (ssh передаёт LC_* в ВМ)
export LC_ALL=C.UTF-8
